    "fd0eacbf-d30c-4c8a-8de3-ed604aae8ab4": {
      "id": "fd0eacbf-d30c-4c8a-8de3-ed604aae8ab4",
      "title": "确认机器人本体与执行器控制方案",
      "description": "官方 14 篇文档均未覆盖执行器控制（GPIO/PWM/CAN/电机），赛前最大未知项。需明确：黑客松机器人本体、电机/舵机接入方式（3588A 的 RS485？外加驱动板？USB？）、传感器清单（摄像头 /dev/video0、雷达等）、控制指令链路（哪个节点写什么设备文件/接口）。通过社区微信群/Discussions/邮件确认，形成书面方案。",
      "status": "ready",
      "priority": "top",
      "success_criteria": [
        {
          "id": "df1ab561-e354-4de7-ad3a-f808be0f07a3",
          "text": "机器人本体型号与传感器清单确定",
          "completed": false
        },
        {
          "id": "5ba591ef-3be8-4490-8b51-8f0c8795b770",
          "text": "执行器硬件接入方案确定（接口类型+驱动方式）",
          "completed": false
        },
        {
          "id": "7d4122e0-fc4e-4bb9-b17b-cf778f8bb2ba",
          "text": "板上控制指令链路确定（节点→接口/设备文件）",
          "completed": false
        },
        {
