#!/bin/sh
# arm — 机械臂关节 CLI（板端直接用）
#
# 用法：
#   ./arm              查看所有关节状态
#   ./arm <id> <位置> [时长秒]   转动关节
#
# id: 1=基座旋转 2=肩 3=肘 4=腕俯仰 5=腕自转 10=夹爪
# 位置: 0-1000（500=中位；夹爪 300=张开 540≈夹住圆柱 不要超过700）
# 例:
#   ./arm 2 300 3      # J2 到 300，3 秒到位
#   ./arm 10 540       # 夹爪闭合
exec sh /data/local/grasping/run_step.sh /data/local/grasping/joint_set.py "$@"
