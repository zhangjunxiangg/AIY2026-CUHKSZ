<?xml version="1.0"?>
<launch>
  <arg name="device" default="/dev/ttyCH343USB0"/>
  <arg name="baudrate" default="1000000"/>
  <arg name="cmd_vel" default="/cmd_vel"/>
  <arg name="use_gamepad" default="false"/>

  <include file="$(find ros_robot_controller)/launch/ros_robot_controller_node.launch">
    <arg name="device" value="$(arg device)"/>
    <arg name="baudrate" value="$(arg baudrate)"/>
    <arg name="cmd_timeout" value="0.5"/>
  </include>

  <node pkg="chassis_controller" type="chassis_controller_node.py"
        name="chassis_controller" required="true" output="screen">
    <rosparam command="load" file="$(find chassis_controller)/config/chassis.yaml"/>
    <param name="cmd_vel_topic" value="$(arg cmd_vel)"/>
  </node>

  <node if="$(arg use_gamepad)" pkg="chassis_controller" type="gamepad_teleop_node.py"
        name="gamepad_teleop" output="screen">
    <param name="joy_topic" value="/ros_robot_controller/joy"/>
    <param name="cmd_vel_topic" value="$(arg cmd_vel)"/>
    <param name="max_linear" value="0.15"/>
    <param name="max_angular" value="0.40"/>
    <param name="joy_timeout" value="0.50"/>
    <param name="deadzone" value="0.10"/>
  </node>
</launch>
