<launch>
  <arg name="map_file" default="/data/robot/maps/map.yaml"/>
  <arg name="scan_topic" default="/scan"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="base_frame" default="base_footprint"/>
  <arg name="odom_frame" default="odom"/>
  <arg name="map_frame" default="map"/>
  <arg name="laser_frame" default="laser"/>

  <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_laser"
        args="0.0 0.0 0.20 0.0 0.0 0.0 $(arg base_frame) $(arg laser_frame)"/>

  <node pkg="map_server" type="map_server" name="map_server" args="$(arg map_file)">
    <param name="frame_id" value="$(arg map_frame)"/>
  </node>

  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <remap from="scan" to="$(arg scan_topic)"/>
    <param name="odom_model_type" value="omni"/>
    <param name="base_frame_id" value="$(arg base_frame)"/>
    <param name="odom_frame_id" value="$(arg odom_frame)"/>
    <param name="global_frame_id" value="$(arg map_frame)"/>
    <param name="transform_tolerance" value="0.6"/>
    <param name="min_particles" value="200"/>
    <param name="max_particles" value="1000"/>
    <param name="laser_max_beams" value="90"/>
    <param name="update_min_d" value="0.10"/>
    <param name="update_min_a" value="0.15"/>
    <param name="resample_interval" value="1"/>
    <param name="odom_alpha1" value="0.20"/>
    <param name="odom_alpha2" value="0.20"/>
    <param name="odom_alpha3" value="0.30"/>
    <param name="odom_alpha4" value="0.30"/>
    <param name="odom_alpha5" value="0.20"/>
  </node>

  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <rosparam file="$(find rk3588s_runtime_navigation)/config/costmap_common.yaml"
              command="load" ns="global_costmap"/>
    <rosparam file="$(find rk3588s_runtime_navigation)/config/costmap_common.yaml"
              command="load" ns="local_costmap"/>
    <rosparam file="$(find rk3588s_runtime_navigation)/config/global_costmap.yaml" command="load"/>
    <rosparam file="$(find rk3588s_runtime_navigation)/config/local_costmap.yaml" command="load"/>
    <rosparam file="$(find rk3588s_runtime_navigation)/config/move_base.yaml" command="load"/>
    <rosparam file="$(find rk3588s_runtime_navigation)/config/dwa.yaml" command="load"/>
    <remap from="cmd_vel" to="$(arg cmd_vel_topic)"/>
  </node>
</launch>
